# Salin berkas ini menjadi .env.local, lalu isi nilainya.
# .env.local tidak pernah ikut ter-commit (sudah masuk .gitignore).
# Untuk produksi, isi nilai yang sama di Vercel → Settings → Environment Variables.

# --- Situs -------------------------------------------------------------------
# Dipakai untuk metadata Open Graph dan sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Autentikasi (Auth.js) ---------------------------------------------------
# AUTH_SECRET: buat dengan `npx auth secret`, atau `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Alamat email yang boleh membuka panel admin. Pisahkan dengan koma.
ADMIN_EMAILS=rizkihaikal@gmail.com

# Domain yang dianggap milik UGM. Subdomain otomatis ikut diterima, jadi
# "ugm.ac.id" sudah mencakup mail.ugm.ac.id dan student.ugm.ac.id.
UGM_EMAIL_DOMAINS=ugm.ac.id

# --- Penyimpanan konten (GitHub sebagai database) ----------------------------
# Konten hidup sebagai berkas di folder content/ dalam repositori ini.
#
# Saat `npm run dev`, panel admin menulis langsung ke disk — nilai di bawah
# tidak diperlukan. Di produksi, setiap simpan menjadi satu commit lewat GitHub
# Contents API, dan Vercel mendeteksinya lalu deploy ulang.
#
# Token: GitHub → Settings → Developer settings → Personal access tokens →
# Fine-grained tokens. Beri akses ke repo ini saja, dengan izin
# "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Paksa mode penulisan: "lokal" atau "github". Kosongkan untuk otomatis
# (lokal saat dev, github saat produksi). Berguna kalau ingin menguji alur
# commit dari komputer sendiri.
CONTENT_WRITE_MODE=

# --- Google: Drive & Sheets --------------------------------------------------
# Satu service account melayani keduanya — membaca berkas materi di Drive dan
# mencatat jejak akses di Sheets. Cara membuatnya ada di README.
#
# Tanpa dua nilai ini, arsip berjalan dalam mode alih: pengunjung tetap
# diverifikasi lalu dialihkan ke tautan Drive, tapi URL aslinya bisa terlihat.
# Kunci privat ditulis satu baris dengan \n sebagai penanda baris baru.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Jejak akses (Google Sheets) ---------------------------------------------
# ID spreadsheet tempat mencatat siapa mengunduh apa. Ambil dari URL-nya:
# docs.google.com/spreadsheets/d/<ID-NYA-DI-SINI>/edit
# Bagikan spreadsheet itu ke alamat service account sebagai Editor.
GOOGLE_SHEETS_LOG_ID=
GOOGLE_SHEETS_LOG_TAB=Log

# Garam untuk hashing alamat IP di jejak akses. Isi teks acak apa saja.
LOG_IP_SALT=
